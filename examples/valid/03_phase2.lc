note: Test all Phase-2 features

note: --- repeat N times ---
set count to 0
repeat 3 times
    set count to count plus 1
    say count
end

note: --- repeat while ---
set x to 5
repeat while x is greater than 0
    say x
    set x to x minus 1
end

note: --- ask (user input) ---
note: ask username
note: say username

note: --- functions with parameter ---
create double using n
    give back n plus n
end

set result to call double using 7
say result

note: --- function without parameter ---
create greet
    say "Hello from greet!"
end

call greet